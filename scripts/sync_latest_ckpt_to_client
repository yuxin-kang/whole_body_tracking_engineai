#!/usr/bin/env bash
# Sync the newest checkpoint from one or more local RSL-RL runs.
#
# The checkpoint keeps the same project-relative path on the client. Existing
# motion data is assumed to be present already; generated T800 get-up motions
# are copied as well because they are new inputs required by that task.

set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  scripts/sync_latest_ckpt_to_client [--dry-run] RUN [RUN ...]

RUN may be either:
  - a project-relative run directory;
  - an absolute run directory inside this project; or
  - an exact run-directory basename under logs/rsl_rl.

Default client connection:
  user:         kyx
  host:         10.12.120.125
  port:         22
  project root: /home/kyx/robot/mimic/whole_body_tracking_engineai

Environment overrides:
  CLIENT_SSH_USER
  CLIENT_SSH_HOST
  CLIENT_SSH_PORT
  CLIENT_PROJECT_ROOT
  CLIENT_SSH_PASSWORD   Use sshpass when set, including a whitespace password.

Examples:
  scripts/sync_latest_ckpt_to_client \
    logs/rsl_rl/t800_flat/2026-08-10_23-47-41_left_front_kick_002_canonical_a4000_j7301_0

  CLIENT_SSH_PASSWORD=' ' scripts/sync_latest_ckpt_to_client RUN_A RUN_B
EOF
}

dry_run=0
if [[ "${1:-}" == "--dry-run" ]]; then
  dry_run=1
  shift
fi
if (( $# == 0 )); then
  usage >&2
  exit 2
fi

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
server_project_root="$(cd -- "$script_dir/.." && pwd)"
server_log_root="$server_project_root/logs/rsl_rl"

client_user="${CLIENT_SSH_USER:-kyx}"
client_host="${CLIENT_SSH_HOST:-10.12.120.125}"
client_port="${CLIENT_SSH_PORT:-22}"
client_project_root="${CLIENT_PROJECT_ROOT:-/home/kyx/robot/mimic/whole_body_tracking_engineai}"
remote_target="$client_user@$client_host"

if [[ ! "$client_port" =~ ^[0-9]+$ ]]; then
  echo "Invalid CLIENT_SSH_PORT: $client_port" >&2
  exit 2
fi
for connection_value in "$client_user" "$client_host" "$client_project_root"; do
  if [[ ! "$connection_value" =~ ^[A-Za-z0-9_./:@-]+$ ]]; then
    echo "Unsafe client connection value: $connection_value" >&2
    exit 2
  fi
done

# SSH/rsync must not use the HTTP proxy configured for downloads and W&B.
unset http_proxy https_proxy HTTP_PROXY HTTPS_PROXY

ssh_options=(
  -p "$client_port"
  -o StrictHostKeyChecking=accept-new
  -o ConnectTimeout=10
)
if [[ -v CLIENT_SSH_PASSWORD ]]; then
  command -v sshpass >/dev/null || {
    echo "CLIENT_SSH_PASSWORD is set, but sshpass is unavailable." >&2
    exit 3
  }
  export SSHPASS="$CLIENT_SSH_PASSWORD"
  ssh_command=(sshpass -e ssh "${ssh_options[@]}")
  rsync_shell="sshpass -e ssh -p $client_port -o StrictHostKeyChecking=accept-new -o ConnectTimeout=10"
else
  ssh_command=(ssh "${ssh_options[@]}")
  rsync_shell="ssh -p $client_port -o StrictHostKeyChecking=accept-new -o ConnectTimeout=10"
fi

resolve_run() {
  local requested="$1"
  local candidate=""
  local matches=()

  if [[ -d "$requested" ]]; then
    candidate="$requested"
  elif [[ -d "$server_project_root/$requested" ]]; then
    candidate="$server_project_root/$requested"
  else
    while IFS= read -r -d '' candidate; do
      if [[ "${candidate##*/}" == "$requested" ]]; then
        matches+=("$candidate")
      fi
    done < <(find "$server_log_root" -mindepth 2 -maxdepth 2 -type d -print0)

    if (( ${#matches[@]} == 0 )); then
      echo "Run not found: $requested" >&2
      return 4
    fi
    if (( ${#matches[@]} > 1 )); then
      echo "Run basename is ambiguous: $requested" >&2
      printf '  %s\n' "${matches[@]}" >&2
      return 4
    fi
    candidate="${matches[0]}"
  fi

  candidate="$(realpath -e -- "$candidate")"
  case "$candidate/" in
    "$server_log_root"/*/) printf '%s\n' "$candidate" ;;
    *)
      echo "Run must be inside $server_log_root: $candidate" >&2
      return 4
      ;;
  esac
}

latest_checkpoint() {
  local run_dir="$1"
  local candidate=""
  local checkpoint=""
  local filename=""
  local version=-1
  local candidate_version=-1

  while IFS= read -r -d '' candidate; do
    filename="${candidate##*/}"
    if [[ "$filename" =~ ^model_([0-9]+)\.pt$ ]]; then
      candidate_version="${BASH_REMATCH[1]}"
    elif [[ "$filename" =~ ^ckpt_([0-9]+)\.pt$ ]]; then
      candidate_version="${BASH_REMATCH[1]}"
    else
      continue
    fi
    if (( 10#$candidate_version > version )); then
      version=$((10#$candidate_version))
      checkpoint="$candidate"
    fi
  done < <(
    find "$run_dir" -maxdepth 2 -type f \
      \( -name 'model_*.pt' -o -name 'ckpt_*.pt' \) -print0
  )

  if [[ -z "$checkpoint" ]]; then
    echo "No numbered checkpoint found under: $run_dir" >&2
    return 5
  fi
  printf '%s\n' "$checkpoint"
}

motion_for_run() {
  local run_name="$1"
  local action=""
  if [[ "$run_name" =~ _V([1-4])_ppo_ ]]; then
    if [[ "$run_name" == *sdk_prone* ]]; then
      printf '%s\n' "data/npz/t800_sdk_get_up/T800_prone_to_stance_sdk_clip_grounded_50hz.npz"
    else
      printf '%s\n' "data/npz/t800_sdk_get_up/T800_supine_to_stance_sdk_clip_50hz.npz"
    fi
    return 0
  fi
  case "$run_name" in
    *ridicule2*)
      printf '%s\n' "data/npz/ridicule_2/ridicule2_t800_50hz.npz"
      return 0
      ;;
    *ridicule*)
      printf '%s\n' "data/npz/ridicule/motion1_t800_50hz.npz"
      return 0
      ;;
    *sdk_supine*)
      printf '%s\n' "data/npz/t800_sdk_get_up/T800_supine_to_stance_sdk_clip_50hz.npz"
      return 0
      ;;
    *sdk_prone*)
      printf '%s\n' "data/npz/t800_sdk_get_up/T800_prone_to_stance_sdk_clip_grounded_50hz.npz"
      return 0
      ;;
    *left_front_kick*mixedwall*)
      printf '%s\n' "data/npz/traj_eng_50hz_episode_complete/left_front_kick_002_terminal_hold_1s.npz"
      return 0
      ;;
    *roundhouse_kick*mixedwall*)
      printf '%s\n' "data/npz/traj_eng_50hz_improved/roundhouse_kick_001_retimed_terminal_hold_1s.npz"
      return 0
      ;;
    *getup_recovery*|*getup_forearm*|*getup_aggressive*)
      printf '%s\n' "data/npz/t800_get_up/faint_prone_getup_03_t800.npz"
      return 0
      ;;
    *roundhouse_kick_001*stable_recovery*)
      printf '%s\n' "data/npz/traj_eng_50hz_improved/roundhouse_kick_001_retimed_terminal_hold_1s.npz"
      return 0
      ;;
    *left_front_kick*target*)
      printf '%s\n' "data/npz/traj_eng_50hz_episode_complete/left_front_kick_002_terminal_hold_1s.npz"
      return 0
      ;;
    *getup1*)
      printf '%s\n' "data/npz/t800_get_up/getup1_t800.npz"
      return 0
      ;;
    *getup4*)
      printf '%s\n' "data/npz/t800_get_up/getup4_t800.npz"
      return 0
      ;;
    *prone_getup_02*)
      printf '%s\n' "data/npz/t800_get_up/prone_getup_02_t800.npz"
      return 0
      ;;
    *getup_smooth*|*smooth_getup*|*getup_anchor2*|*getup_anchor3*)
      printf '%s\n' "data/npz/t800_get_up/faint_prone_getup_03_t800.npz"
      return 0
      ;;
    *faint_prone_getup_03*)
      printf '%s\n' "data/npz/t800_get_up/faint_prone_getup_03_t800.npz"
      return 0
      ;;
    *straight_punch_L*improved*)
      printf '%s\n' "data/npz/traj_eng_50hz_improved/straight_punch_L_terminal_hold_0p5s.npz"
      return 0
      ;;
    *straight_punch_R*improved*)
      printf '%s\n' "data/npz/traj_eng_50hz_improved/straight_punch_R_terminal_hold_0p5s.npz"
      return 0
      ;;
    *left_hook_001*improved*)
      printf '%s\n' "data/npz/traj_eng_50hz_improved/left_hook_001_terminal_hold_0p5s.npz"
      return 0
      ;;
    *roundhouse_kick_001*improved*)
      printf '%s\n' "data/npz/traj_eng_50hz_improved/roundhouse_kick_001_retimed_terminal_hold_1s.npz"
      return 0
      ;;
  esac
  if [[ "$run_name" == *"complete_episode_hold1s"* || "$run_name" == *"complete_episode_heightfall"* ]]; then
    for action in left_front_kick_002 roundhouse_kick_001; do
      if [[ "$run_name" == *"$action"* ]]; then
        printf 'data/npz/traj_eng_50hz_episode_complete/%s_terminal_hold_1s.npz\n' "$action"
        return 0
      fi
    done
  fi
  for action in \
    left_front_kick_002 \
    roundhouse_kick_001 \
    straight_punch_R \
    straight_punch_L \
    left_hook_001 \
    rear_hook_001; do
    if [[ "$run_name" == *"$action"* ]]; then
      printf 'data/npz/traj_eng_50hz_canonical/%s.npz\n' "$action"
      return 0
    fi
  done
  return 1
}

task_for_run() {
  local run_name="$1"
  local variant=""
  local method=""
  if [[ "$run_name" =~ _V([1-4])_ppo_ ]]; then
    variant="${BASH_REMATCH[1]}"
    if [[ "$run_name" == *sdk_prone* ]]; then
      printf '%s\n' "Tracking-Flat-T800-GetUp-SDK-Prone-V${variant}-PPO-v0"
    else
      printf '%s\n' "Tracking-Flat-T800-GetUp-SDK-Supine-V${variant}-PPO-v0"
    fi
    return 0
  fi
  case "$run_name" in
    *ridicule*)
      printf '%s\n' "Tracking-Flat-T800-v0"
      ;;
    *sdk_prone*|*sdk_supine*)
      printf '%s\n' "Tracking-Flat-T800-GetUp-v0"
      ;;
    *left_front_kick*mixedwall*)
      printf '%s\n' "Tracking-Flat-T800-Target-MixedWall-LeftFrontKick-v0"
      ;;
    *roundhouse_kick*mixedwall*)
      printf '%s\n' "Tracking-Flat-T800-Target-MixedWall-RoundhouseKick-v0"
      ;;
    *getup_forearm_f1*)
      printf '%s\n' "Tracking-Flat-T800-GetUp-Aggressive-C-Forearm-F1-v0"
      ;;
    *getup_forearm_f2*)
      printf '%s\n' "Tracking-Flat-T800-GetUp-Aggressive-C-Forearm-F2-v0"
      ;;
    *getup_forearm_f3*)
      printf '%s\n' "Tracking-Flat-T800-GetUp-Aggressive-C-Forearm-F3-v0"
      ;;
    *getup_forearm_f4*)
      printf '%s\n' "Tracking-Flat-T800-GetUp-Aggressive-C-Forearm-F4-v0"
      ;;
    *getup_recovery*velgate*)
      printf '%s\n' "Tracking-Flat-T800-GetUp-Recovery-OriVelGate-v0"
      ;;
    *getup_recovery*)
      printf '%s\n' "Tracking-Flat-T800-GetUp-Recovery-Ori-v0"
      ;;
    *getup_aggressive_a*)
      printf '%s\n' "Tracking-Flat-T800-GetUp-Aggressive-A-v0"
      ;;
    *getup_aggressive_b*)
      printf '%s\n' "Tracking-Flat-T800-GetUp-Aggressive-B-v0"
      ;;
    *getup_aggressive_c*)
      printf '%s\n' "Tracking-Flat-T800-GetUp-Aggressive-C-v0"
      ;;
    *getup_aggressive_d*)
      printf '%s\n' "Tracking-Flat-T800-GetUp-Aggressive-D-v0"
      ;;
    *roundhouse_kick_001*stable_recovery*)
      printf '%s\n' "Tracking-Flat-T800-Improved-RoundhouseKick-StableRecovery-v0"
      ;;
    *left_front_kick*target*)
      printf '%s\n' "Tracking-Flat-T800-Target-LeftFrontKick-v0"
      ;;
    *getup_smooth*|*smooth_getup*|*getup_anchor2*|*getup_anchor3*)
      printf '%s\n' "Tracking-Flat-T800-GetUp-Smooth-v0"
      ;;
    *getup1*|*getup4*|*prone_getup_02*|*faint_prone_getup_03*)
      printf '%s\n' "Tracking-Flat-T800-GetUp-v0"
      ;;
    *straight_punch_L*improved*)
      printf '%s\n' "Tracking-Flat-T800-Improved-StraightPunchL-v0"
      ;;
    *straight_punch_R*improved*)
      printf '%s\n' "Tracking-Flat-T800-Improved-StraightPunchR-v0"
      ;;
    *left_hook_001*improved*)
      printf '%s\n' "Tracking-Flat-T800-Improved-LeftHook-v0"
      ;;
    *roundhouse_kick_001*improved*)
      printf '%s\n' "Tracking-Flat-T800-Improved-RoundhouseKick-v0"
      ;;
    *left_front_kick_002*complete_episode_heightfall*)
      printf '%s\n' "Tracking-Flat-T800-Baseline-LeftFrontKick-CompleteEpisode-HeightFallOnly-v0"
      ;;
    *left_front_kick_002*complete_episode_hold1s*)
      printf '%s\n' "Tracking-Flat-T800-Baseline-LeftFrontKick-CompleteEpisode-v0"
      ;;
    *roundhouse_kick_001*complete_episode_hold1s*)
      printf '%s\n' "Tracking-Flat-T800-Baseline-RoundhouseKick-CompleteEpisode-v0"
      ;;
    *)
      printf '%s\n' "Tracking-Flat-T800-v0"
      ;;
  esac
}

motion_requires_sync() {
  [[ "$1" == data/npz/t800_get_up/* || "$1" == data/npz/t800_sdk_get_up/* ||
     "$1" == data/npz/ridicule/* || "$1" == data/npz/ridicule_2/* ]]
}

run_dirs=()
checkpoints=()
for requested_run in "$@"; do
  run_dir="$(resolve_run "$requested_run")"
  checkpoint="$(latest_checkpoint "$run_dir")"
  run_dirs+=("$run_dir")
  checkpoints+=("$checkpoint")
done

if (( dry_run == 0 )); then
  if ! "${ssh_command[@]}" "$remote_target" "test -d '$client_project_root'"; then
    echo "Client project root does not exist: $remote_target:$client_project_root" >&2
    exit 6
  fi
fi

for index in "${!run_dirs[@]}"; do
  run_dir="${run_dirs[$index]}"
  checkpoint="${checkpoints[$index]}"
  run_name="${run_dir##*/}"
  checkpoint_name="${checkpoint##*/}"
  relative_checkpoint="${checkpoint#"$server_project_root/"}"
  remote_checkpoint="$client_project_root/$relative_checkpoint"
  remote_directory="${remote_checkpoint%/*}"
  motion=""
  task="$(task_for_run "$run_name")"
  if motion="$(motion_for_run "$run_name")"; then
    :
  else
    motion="UNKNOWN_MOTION"
  fi

  echo "run=$run_name"
  echo "checkpoint=$relative_checkpoint"
  echo "client=$remote_target:$remote_checkpoint"

  if (( dry_run == 1 )); then
    echo "status=dry-run"
  else
    "${ssh_command[@]}" "$remote_target" "mkdir -p -- '$remote_directory'"
    rsync -av --protect-args -e "$rsync_shell" \
      "$checkpoint" "$remote_target:$remote_directory/"

    local_sha="$(sha256sum -- "$checkpoint" | awk '{print $1}')"
    remote_sha="$(
      "${ssh_command[@]}" "$remote_target" \
        "sha256sum -- '$remote_checkpoint' | cut -d ' ' -f 1"
    )"
    if [[ "$local_sha" != "$remote_sha" ]]; then
      echo "Checkpoint hash mismatch: $relative_checkpoint" >&2
      exit 7
    fi
    echo "sha256=$local_sha"
    echo "status=synced"

    if [[ "$motion" != "UNKNOWN_MOTION" ]]; then
      remote_motion="$client_project_root/$motion"
      if motion_requires_sync "$motion"; then
        local_motion="$server_project_root/$motion"
        remote_motion_directory="${remote_motion%/*}"
        if [[ ! -r "$local_motion" ]]; then
          echo "Motion file is unavailable: $local_motion" >&2
          exit 8
        fi
        "${ssh_command[@]}" "$remote_target" "mkdir -p -- '$remote_motion_directory'"
        rsync -av --protect-args -e "$rsync_shell" \
          "$local_motion" "$remote_target:$remote_motion"

        local_motion_sha="$(sha256sum -- "$local_motion" | awk '{print $1}')"
        remote_motion_sha="$(${ssh_command[@]} "$remote_target" \
          "sha256sum -- '$remote_motion' | cut -d ' ' -f 1")"
        if [[ "$local_motion_sha" != "$remote_motion_sha" ]]; then
          echo "Motion hash mismatch: $motion" >&2
          exit 9
        fi
        echo "motion_sha256=$local_motion_sha"
        echo "motion_status=synced"
      elif ! "${ssh_command[@]}" "$remote_target" \
        "test -f '$remote_motion'"; then
        echo "warning=client motion missing: $motion" >&2
      fi
    fi
  fi

  if [[ "$motion" == "UNKNOWN_MOTION" ]]; then
    echo "play=unknown motion mapping for $run_name" >&2
  else
    echo "play=cd $client_project_root && python scripts/rsl_rl/play.py --task $task --motion_file $motion --load_run $run_name --checkpoint $checkpoint_name --num_envs 1 --play_from_start true"
  fi
  echo
done
